# Required
ITEMWATCH_GAME_DSN=itemwatch:change-me@tcp(db:3306)/game
ITEMWATCH_STATE_DSN=itemwatch:change-me@tcp(db:3306)/itemwatch
ITEMWATCH_REDIS_URL=redis://:change-me@redis:6379/0

# API
ITEMWATCH_HTTP_ADDR=:8080
ITEMWATCH_API_TOKEN=change-me

# Notifications
ITEMWATCH_DISCORD_WEBHOOK_URL=
ITEMWATCH_DISCORD_MIN_SEVERITY=warning
ITEMWATCH_LANG=en

# Health checks, all off unless set
ITEMWATCH_PROBE_STATUS_ADDR=
ITEMWATCH_PROBE_LOGIN_URL=
ITEMWATCH_PROBE_LOGIN_EMAIL=
ITEMWATCH_PROBE_LOGIN_PASSWORD=
ITEMWATCH_PROBE_DB_WRITE=false
ITEMWATCH_PROBE_INTERVAL=30s
ITEMWATCH_PROBE_FAIL_AFTER=5m
